# Copiar para .env.local (desenvolvimento) e definir no painel da Vercel (producao).
# Os ficheiros .env sao lidos da RAIZ do projeto, nunca de src/.

# Endereco publico do site, sem barra no fim. Fonte unica do dominio: alimenta o
# metadataBase (imagens de partilha), o sitemap.xml, o robots.txt e o QR code das
# mesas (`npm run menu:qr`). Ver src/lib/site.ts.
# Sem ela assume-se o subdominio de demonstracao da Vercel — o que serve para
# desenvolvimento, mas ⚠️ NAO IMPRIMIR QR CODES enquanto for esse o valor.
NEXT_PUBLIC_SITE_URL=

# Palavra-passe partilhada da area /admin, onde os funcionarios escrevem as diarias.
# E uma so palavra-passe para toda a equipa: protege contra alteracoes acidentais e
# curiosos, nao contra um atacante determinado. Escolher algo que a equipa decore.
ADMIN_PASSWORD=

# Segredo usado para assinar o cookie de sessao do /admin (HMAC-SHA256).
# Gerar com:  openssl rand -base64 32
# Trocar este valor invalida todas as sessoes abertas.
ADMIN_SESSION_SECRET=

# Chave da API do DeepL — traduz as diarias de PT para EN/FR/ES ao gravar.
# Usar o plano GRATUITO (DeepL API Free): as chaves gratuitas terminam em ":fx"
# e o codigo escolhe o endereco certo por esse sufixo. O plano gratuito bloqueia
# com erro quando a quota acaba — nunca passa a cobrar, que e o que aqui
# interessa: o restaurante nao pode ter despesa recorrente.
# Opcional: sem ela o site continua a funcionar. Os pratos que estao em
# src/lib/dicionario-pratos.ts aparecem traduzidos na mesma (nao precisam de
# rede); o resto fica em portugues nas quatro linguas e o /admin avisa disso.
# https://www.deepl.com/pro-api
DEEPL_API_KEY=

# Injetada automaticamente pela Vercel ao ativar o Blob no projeto (Storage -> Blob).
# Em desenvolvimento deixar vazia: sem ela as diarias sao guardadas em .data/diarias.json.
BLOB_READ_WRITE_TOKEN=
